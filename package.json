{
  "name": "gk-fitness",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "build:apk": "vite build -c vite.apk.config.ts && python android/build_apk.py dist-apk GK-Fitness.apk android/signing",
    "setup:deploy": "node deploy/setup.mjs"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
